#include <stdio.h>

#define MAX 3

int main()
{
    int pages[] = {7,0,1,2,0,3,0,4,2,3,0,3,2};
    int frames[MAX], time[MAX];
    int n = 13, faults = 0;
    int i, j, pos, found, counter = 0;

    for(i=0; i<MAX; i++)
    {
        frames[i] = -1;
        time[i] = 0;
    }

    for(i=0; i<n; i++)
    {
        found = 0;

        for(j=0; j<MAX; j++)
        {
            if(frames[j] == pages[i])
            {
                found = 1;
                time[j] = ++counter;
                break;
            }
        }

        if(!found)
        {
            pos = 0;

            for(j=0; j<MAX; j++)
            {
                if(frames[j] == -1)
                {
                    pos = j;
                    break;
                }

                if(time[j] < time[pos])
                    pos = j;
            }

            frames[pos] = pages[i];
            time[pos] = ++counter;
            faults++;
        }

        printf("%d : ", pages[i]);

        for(j=0; j<MAX; j++)
            printf("%d ", frames[j]);

        printf("\n");
    }

    printf("Total Page Faults = %d\n", faults);

    return 0;
}
